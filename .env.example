# ==============================================================================
# BIẾN MÔI TRƯỜNG DỰ ÁN (ENVIRONMENT TEMPLATE)
# Copy file này thành .env.local và điền giá trị thực tế của bạn
# Khởi chạy: flutter run --dart-define-from-file=.env.local
# ==============================================================================

# Supabase Cloud Project Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-anon-key

# Serper Google Search API Key
SERPER_API_KEY=your-serper-api-key

# Local AI Backend Server
LOCAL_API_BASE_URL=http://127.0.0.1:8765
