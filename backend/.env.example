# Copy this file to backend/.env.local and fill in the values for this machine.
# The server reads backend/.env.local, not either .env.example file.
# Keep database passwords and API keys only in the ignored local file.

# Shared model directory outside the cloned repository.
MEDGEMMA_MODEL_PATH=D:/DATA/.CODEX/DoAnVinhPhatNam/medgemma-1.5-4b-it

# Required when using the existing Supabase knowledge store: paste the full
# Session pooler URI into backend/.env.local, replacing the example values.
# Example: postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
# A blank value selects local SQLite, which is not included in a fresh clone.
MEDGEMMA_KB_DATABASE_URL=

# Parent of TaiLieuNguon; reuse the existing PDFs on this machine.
# Change this path if the source PDFs are stored elsewhere.
MEDGEMMA_KB_SOURCE_ROOT=D:/DATA/.CODEX/DoAnVinhPhatNam/WebVinhNamPhat_CamNang/backend/runtime

# Optional SQLite alternative when MEDGEMMA_KB_DATABASE_URL is blank.
# MEDGEMMA_KB_PATH=D:/path/to/knowledge_base/so_cuu.sqlite3
MEDGEMMA_ALLOW_LOCAL_WEB=1
MEDGEMMA_ALLOWED_ORIGINS=
# Optional override: Serper.dev API key for Google Maps (leave commented to use /admin + Supabase key).
# SERPER_API_KEY=
