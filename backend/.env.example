# Set an absolute path on the machine that hosts the model.
MEDGEMMA_MODEL_PATH=D:/DATA/.CODEX/DoAnVinhPhatNam/medgemma-1.5-4b-it
# Optional: MEDGEMMA_KB_PATH points to so_cuu.sqlite3; default is backend/runtime/knowledge_base.
# Set only in backend/.env.local to use PostgreSQL. Copy the Supabase Session pooler URI.
# MEDGEMMA_KB_DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
# Optional: directory containing TaiLieuNguon. The default is backend/runtime.
# MEDGEMMA_KB_SOURCE_ROOT=D:/DATA/.CODEX/DoAnVinhPhatNam/WebVinhNamPhat_CamNang/backend/runtime
MEDGEMMA_ALLOW_LOCAL_WEB=1
MEDGEMMA_ALLOWED_ORIGINS=
# Optional override: Serper.dev API key for Google Maps (leave commented to use /admin + Supabase key).
# SERPER_API_KEY=
